# App Settings
APP_NAME=MockMitra
DEBUG=True

# Database (use PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./mockmitra.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mockmitra

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Settings (for question generation)
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Exam Configs Path
EXAM_CONFIGS_PATH=exam_configs
