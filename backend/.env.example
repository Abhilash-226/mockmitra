# App Settings
APP_NAME=MockMitra
DEBUG=True

# Database (MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=mockmitra

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Settings (for question generation)
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_VALIDATOR_MODEL=gemini-2.5-flash
GEMINI_VALIDATOR_THINKING_BUDGET=1024

# Generation/Validation Throughput Controls
AI_GENERATION_SECTION_MAX_WORKERS=3
AI_GENERATION_SECTION_TIMEOUT_SECONDS=180
AI_GENERATION_OVERALL_TIMEOUT_SECONDS=0
AI_GENERATION_TIMEOUT_PER_QUESTION_SECONDS=75
VALIDATOR_GLOBAL_CONCURRENCY=2
VALIDATOR_MAX_CALLS_PER_SECOND=0.7
VALIDATOR_429_COOLDOWN_SECONDS=25
VALIDATOR_NUMERIC_EQUIVALENCE_TOLERANCE=1e-6
GENERATOR_GLOBAL_CONCURRENCY=1
GENERATOR_MAX_CALLS_PER_SECOND=0.5
GENERATOR_429_COOLDOWN_SECONDS=12

# Exam Configs Path
EXAM_CONFIGS_PATH=exam_configs

# CORS
BACKEND_CORS_ORIGINS=["https://mockmitra.app","https://www.mockmitra.app"]
CORS_ALLOW_ALL=false
